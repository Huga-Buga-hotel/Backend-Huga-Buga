# Copie para .env e ajuste os valores: cp .env.example .env
# O docker compose lê este arquivo automaticamente. Nunca versione o .env real.

# Banco (o container "db" é criado com estes valores)
DB_USER=hugabuga
DB_PASSWORD=troque-esta-senha

# Segredo do JWT: mínimo de 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SEGREDO=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGENS=http://localhost:3000,http://localhost:5173

# Perfil do Spring. "dev" habilita o Pix simulado e a confirmação manual; deixe vazio em produção.
SPRING_PROFILES_ACTIVE=dev

# Chatbot (rode no host: uvicorn app:app --port 8000). Mesmo valor do CHATBOT_TOKEN do chatbot;
# vazio = sem token (só desenvolvimento).
CHATBOT_TOKEN=
