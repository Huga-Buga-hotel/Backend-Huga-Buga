# Copie para .env (nesta pasta) e preencha. NUNCA versione o .env real.

# Domínio apontando para o Elastic IP da EC2. Sem domínio próprio, use o sslip.io:
# Elastic IP 3.91.10.20  ->  DOMINIO=3-91-10-20.sslip.io
DOMINIO=api.seudominio.com.br

# --- RDS (PostgreSQL 16) ---
# sslmode=require: o RDS exige conexão criptografada (rds.force_ssl)
DB_URL=jdbc:postgresql://hugabuga.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/hugabuga?sslmode=require
DB_USER=hugabuga
DB_PASSWORD=troque-esta-senha

# Gere com: openssl rand -base64 48
JWT_SEGREDO=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Site (WebApp) que pode chamar a API pelo navegador. O app Android não precisa de CORS.
CORS_ORIGENS=https://www.seudominio.com.br

# --- S3 (fotos das avaliações) ---
# Credenciais NÃO vão aqui: a EC2 usa uma IAM role com acesso ao bucket.
S3_BUCKET=hugabuga-uploads-seunome
AWS_REGION=us-east-1

# --- Chatbot ---
GROQ_API_KEY=sua_chave_groq
# Segredo entre a API e o chatbot. Gere com: openssl rand -hex 32
CHATBOT_TOKEN=troque-por-um-segredo
# Onde está o repositório do chatbot (relativo a esta pasta)
CHATBOT_DIR=../../../chatbot-huga-buga-hotel
